grab(./shell.html)

body {
    color: #f0f2f5
    padding: 0px
    margin: 0px
    font-size: 15px
}

#header {
    color: #1a1f2e
    padding: 16px
    width: 800px
    height: 52px
}

#logo {
    textcolor: #7c9fd4
    font-size: 20px
}

#card {
    color: #252d3d
    padding: 40px
    width: 800px
    margin: 0px
    border: 0px
}

h1 {
    textcolor: #e8edf5
    font-size: 28px
    margin: 0px
}

#title {
    textcolor: #e8edf5
    font-size: 28px
}

#sub {
    textcolor: #8a9ab8
    font-size: 15px
    margin: 16px
}

#query {
    width: 640px
    height: 36px
    padding: 8px
    border: 1px
    font-size: 15px
    color: #1e2638
    textcolor: #e8edf5
}

#hint {
    textcolor: #5a6a85
    font-size: 12px
    margin: 12px
}

#footer {
    color: #1a1f2e
    padding: 16px
    width: 800px
}

#footertext {
    textcolor: #3d4f6a
    font-size: 11px
}
